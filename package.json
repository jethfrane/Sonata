{
  "name": "sonata",
  "version": "4.4.0",
  "private": true,
  "description": "Sonata: chord charts and music tools for musicians and worship teams. Offline-first PWA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "test": "node --test tests/core.test.mjs tests/api.test.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "serve:dist": "node tests/serve.mjs 5391 dist",
    "test:browser": "node tests/browser.e2e.mjs",
    "test:a11y": "node tests/a11y.e2e.mjs",
    "test:regression": "node tests/regression.e2e.mjs",
    "test:features": "node tests/features.e2e.mjs",
    "test:audit": "node tests/audit.mjs",
    "test:live": "node tests/live.smoke.mjs",
    "check": "npm test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "jsqr": "1.4.0",
    "playwright": "1.64.1",
    "typescript": "5.6.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
